# Public frontend (never put service_role here).
# Local: copy to .env.local
# Remote/Lovable: set the same keys in project env, or rely on
# src/lib/supabase-public-config.ts publishable fallbacks.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias used by some Lovable templates:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin used in Auth emails (confirmation / OAuth / reset).
# Must match an entry in Supabase → Authentication → URL Configuration.
# Example local: http://localhost:5173
# Example Lovable: https://your-app.lovable.app
VITE_PUBLIC_APP_URL=

# Test-phase one-click login (real Supabase seed accounts).
# On in Vite DEV by default. On Lovable/preview set:
VITE_ENABLE_TEST_LOGIN=true
# Optional password override (defaults to seeded QA password):
# VITE_TEST_ACCOUNT_PASSWORD=

# Dev-only offline demo auth (never enable in production). Requires DEV + no Supabase config.
# VITE_ENABLE_DEMO_AUTH=true

# Edge Function secrets (Supabase secrets / dashboard only — not VITE_*)
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# Supabase Auth URL allow-list (Dashboard → Authentication → URL Configuration):
# Site URL = same value as VITE_PUBLIC_APP_URL (NOT leftover localhost if you deploy remotely)
# Redirect URLs (add ALL environments you use):
#   http://localhost:5173/**
#   http://localhost:5173/auth/callback
#   http://localhost:5173/auth/reset-password
#   https://YOUR_PRODUCTION_OR_LOVABLE_ORIGIN/**
#   https://YOUR_PRODUCTION_OR_LOVABLE_ORIGIN/auth/callback
#   https://YOUR_PRODUCTION_OR_LOVABLE_ORIGIN/auth/reset-password
