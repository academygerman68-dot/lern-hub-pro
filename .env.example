# Public frontend (never put service_role here).
# Local: copy to .env.local
# Remote/Lovable: set the same keys in project env, or rely on
# src/lib/supabase-public-config.ts publishable fallbacks.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias used by some Lovable templates:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev-only demo auth (never enable in production). Requires DEV + no Supabase config.
# VITE_ENABLE_DEMO_AUTH=true

# Edge Function secrets (Supabase secrets / dashboard only — not VITE_*)
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# Supabase Auth URL allow-list (configure in Dashboard, not as VITE_*):
# Site URL: http://localhost:5173 (or your production origin)
# Redirect URLs:
#   http://localhost:5173/auth/callback
#   http://localhost:5173/auth/reset-password
#   https://YOUR_PRODUCTION_ORIGIN/auth/callback
#   https://YOUR_PRODUCTION_ORIGIN/auth/reset-password
